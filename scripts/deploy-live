#!/bin/bash
# Deploys a commit to the live pi-web (the launchd service running the ../pi-web-live worktree, see RUNBOOK.md,
# "Working on pi-web from pi-web") without cutting a running turn short.
#
# usage: scripts/deploy-live [--dry-run] [commit]      commit: default HEAD of this checkout, resolved right away
#
# It queues itself in tmux (socket pi-web-deploy) and returns. The queued run waits until no session is mid-turn
# (an agent that runs this as its last step finishes its turn first), checks the commit out in the live worktree,
# runs bun install there if package.json or bun.lock changed, restarts the service, and waits for a new server
# process to answer /health. If none does within 90s, it puts back the commit that was live and restarts that.
# Deploying the commit that is already live just restarts it. --dry-run says what it would do and stops.
#
#   log:     /tmp/pi-web-deploy.log (PI_WEB_DEPLOY_LOG)
#   cancel:  tmux -L pi-web-deploy kill-session -t deploy     (safe while it waits for running turns)
#
# env: PI_WEB_LIVE              the live worktree (default: pi-web-live next to this checkout)
#      PI_WEB_PORT              the live server's port, for /health on 127.0.0.1 (default 4317)
#      PI_WEB_DEPLOY_MAX_WAIT   seconds to wait for running turns before deploying anyway, which aborts them
#                               (default 600; 0 waits as long as it takes)
#      PI_WEB_DEPLOY_RESTART    restart command, run in the live worktree (default: bun src/cli.ts service restart)
#
# --now runs the queued part in the foreground. Only use it from a terminal outside pi-web: the restart ends
# every process the live server started, which would include this script.
set -uo pipefail

SOCKET=pi-web-deploy
SESSION=deploy
SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SCRIPT")/.." && pwd -P)"
LIVE="${PI_WEB_LIVE:-$(dirname "$REPO")/pi-web-live}"
PORT="${PI_WEB_PORT:-4317}"
HEALTH="http://127.0.0.1:$PORT/health"
LOG="${PI_WEB_DEPLOY_LOG:-/tmp/pi-web-deploy.log}"
MAX_WAIT="${PI_WEB_DEPLOY_MAX_WAIT:-600}"
HEALTH_WAIT=90
BUN="$(command -v bun || echo "$HOME/.bun/bin/bun")"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
die() {
	printf 'deploy-live: %s\n' "$*" >&2
	exit 1
}
usage() { sed -n '2,/^set /p' "$SCRIPT" | sed -e '$d' -e 's/^# \{0,1\}//'; }
short() { git -C "$REPO" log -1 --format='%h %s' "$1" 2>/dev/null | cut -c1-90; }

health() { curl -sf --max-time 3 "$HEALTH" 2>/dev/null; }
health_field() { health | jq -r --arg key "$1" '.[$key] // empty' 2>/dev/null; }
health_summary() {
	local body
	body=$(health)
	[ -n "$body" ] && jq -r '"pid \(.pid), up \(.uptimeSeconds)s, \(.busySessions) mid-turn"' <<<"$body" 2>/dev/null || echo "not answering"
}

is_checkout() { [ -d "$LIVE" ] && [ "$(git -C "$LIVE" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$LIVE" && pwd -P)" ]; }
live_dirty() { ! git -C "$LIVE" diff --quiet HEAD --; }
deps_changed() { ! git -C "$LIVE" diff --quiet "$1" "$2" -- package.json bun.lock; }

# $1 the commit the live checkout leaves, $2 the one it's on now
sync_deps() {
	deps_changed "$1" "$2" || return 0
	log "package.json or bun.lock changed: bun install --frozen-lockfile"
	(cd "$LIVE" && "$BUN" install --frozen-lockfile)
}

restart() {
	if [ -n "${PI_WEB_DEPLOY_RESTART:-}" ]; then
		(cd "$LIVE" && bash -c "$PI_WEB_DEPLOY_RESTART")
	else
		(cd "$LIVE" && "$BUN" src/cli.ts service restart)
	fi
}

# a server process other than $1 answers /health, and is still the one answering 5s later
new_server_up() {
	local old=$1 waited=0 pid
	while [ "$waited" -lt "$HEALTH_WAIT" ]; do
		pid=$(health | jq -r 'select(.ok == true) | .pid // empty' 2>/dev/null)
		if [ -n "$pid" ] && [ "$pid" != "$old" ]; then
			sleep 5
			[ "$(health_field pid)" = "$pid" ] && return 0
		fi
		sleep 2
		waited=$((waited + 2))
	done
	return 1
}

wait_for_idle() {
	local quiet=0 waited=0 busy
	sleep 10
	while :; do
		busy=$(health_field busySessions)
		# a server that doesn't answer has no turn to cut short
		if [ -z "$busy" ] || [ "$busy" = 0 ]; then quiet=$((quiet + 1)); else quiet=0; fi
		if [ "$quiet" -ge 2 ]; then
			log "nothing mid-turn"
			return 0
		fi
		if [ "$MAX_WAIT" -gt 0 ] && [ "$waited" -ge "$MAX_WAIT" ]; then
			log "$busy session(s) still mid-turn after ${MAX_WAIT}s: deploying anyway, which aborts them"
			return 0
		fi
		sleep 3
		waited=$((waited + 3))
	done
}

# $1 commit, $2 the commit that was live, $3 the pid that was serving. 2: checkout failed, 3: bun install
# failed, 4: the restart command failed, 5: no new server came up
switch_to() {
	git -C "$LIVE" checkout -q --detach "$1" || return 2
	sync_deps "$2" "$1" || return 3
	restart || return 4
	new_server_up "$3" || return 5
}

# the checkout and its dependencies back on $1, leaving $2; the server is left alone
put_back() {
	if git -C "$LIVE" checkout -q --detach "$1" && sync_deps "$2" "$1"; then
		log "live checkout back on $(short "$1")"
		return 0
	fi
	log "COULD NOT PUT $(short "$1") BACK: the live checkout is on $(short "$(git -C "$LIVE" rev-parse HEAD)")"
	return 1
}

roll_back() {
	local pid
	log "rolling back to $(short "$1")"
	pid=$(health_field pid)
	if put_back "$1" "$2" && restart && new_server_up "$pid"; then
		log "rolled back"
	else
		log "ROLLBACK FAILED: see ~/.pi-web/logs"
	fi
}

run_deploy() {
	local target=$1 from pid status
	log "deploy $(short "$target")"
	log "waiting until no session is mid-turn"
	wait_for_idle
	if ! is_checkout || live_dirty; then
		log "$LIVE is not a clean git checkout: nothing deployed"
		return 1
	fi
	from=$(git -C "$LIVE" rev-parse HEAD)
	pid=$(health_field pid)
	[ "$from" = "$target" ] && log "already live: restarting it"
	switch_to "$target" "$from" "$pid"
	status=$?
	case $status in
	0)
		log "live on $(short "$target") ($(health_summary))"
		return 0
		;;
	2) log "checkout failed: live untouched" ;;
	3)
		log "bun install failed: the running server was never restarted"
		put_back "$from" "$target"
		;;
	4)
		if [ -n "$pid" ] && [ "$(health_field pid)" = "$pid" ]; then
			log "the restart failed and the running server never stopped"
			put_back "$from" "$target"
		else
			log "the restart failed"
			roll_back "$from" "$target"
		fi
		;;
	5)
		log "no new server answered /health within ${HEALTH_WAIT}s"
		roll_back "$from" "$target"
		;;
	esac
	log "server: $(health_summary)"
	return 1
}

dry_run() {
	local target=$1 from
	from=$(git -C "$LIVE" rev-parse HEAD)
	echo "live:     $LIVE, on $(short "$from")"
	if [ "$from" = "$target" ]; then echo "deploy:   $(short "$target") (already live: it would only restart)"; else echo "deploy:   $(short "$target")"; fi
	if deps_changed "$from" "$target"; then echo "deps:     changed, bun install --frozen-lockfile in the live checkout"; else echo "deps:     unchanged"; fi
	echo "server:   $HEALTH: $(health_summary)"
	echo "restart:  ${PI_WEB_DEPLOY_RESTART:-bun src/cli.ts service restart} (in the live checkout)"
	if [ "$MAX_WAIT" -gt 0 ]; then echo "waits:    up to ${MAX_WAIT}s for running turns, then aborts them"; else echo "waits:    for running turns, however long they take"; fi
	if live_dirty; then echo "BLOCKED:  the live checkout has uncommitted changes"; fi
	if tmux -L "$SOCKET" has-session -t "$SESSION" 2>/dev/null; then echo "BLOCKED:  a deploy is already queued or running"; fi
	return 0
}

queue() {
	local target=$1 vars=()
	command -v tmux >/dev/null || die "needs tmux"
	if tmux -L "$SOCKET" has-session -t "$SESSION" 2>/dev/null; then
		die "a deploy is already queued or running (log: $LOG; cancel: tmux -L $SOCKET kill-session -t $SESSION)"
	fi
	live_dirty && die "$LIVE has uncommitted changes; not deploying over them"
	if [ "${2:-}" = HEAD ] && ! git -C "$REPO" diff --quiet HEAD --; then
		echo "note: uncommitted changes in $REPO are not part of this deploy"
	fi
	vars=(-e "PI_WEB_LIVE=$LIVE" -e "PI_WEB_PORT=$PORT" -e "PI_WEB_DEPLOY_LOG=$LOG" -e "PI_WEB_DEPLOY_MAX_WAIT=$MAX_WAIT")
	[ -n "${PI_WEB_DEPLOY_RESTART:-}" ] && vars+=(-e "PI_WEB_DEPLOY_RESTART=$PI_WEB_DEPLOY_RESTART")
	tmux -L "$SOCKET" new-session -d -s "$SESSION" "${vars[@]}" bash -c 'exec "$0" --now "$1" >"$2" 2>&1' "$SCRIPT" "$target" "$LOG" ||
		die "couldn't start the tmux session"
	echo "queued $(short "$target")"
	echo "it goes live once no session is mid-turn; log: $LOG"
}

main() {
	local mode=queue target
	while [ "$#" -gt 0 ]; do
		case $1 in
		--dry-run) mode=dry ;;
		--now) mode=now ;;
		-h | --help)
			usage
			return 0
			;;
		-*) die "unknown option $1 (see --help)" ;;
		*) break ;;
		esac
		shift
	done
	[ "$#" -le 1 ] || die "one commit at most (see --help)"
	command -v jq >/dev/null && command -v curl >/dev/null || die "needs jq and curl"
	case $MAX_WAIT in '' | *[!0-9]*) die "PI_WEB_DEPLOY_MAX_WAIT must be a whole number of seconds" ;; esac
	target=$(git -C "$REPO" rev-parse --verify --quiet "${1:-HEAD}^{commit}") || die "not a commit: ${1:-HEAD}"
	is_checkout || die "$LIVE is not a git checkout (set PI_WEB_LIVE)"
	case $mode in
	now) run_deploy "$target" ;;
	dry) dry_run "$target" ;;
	queue) queue "$target" "${1:-HEAD}" ;;
	esac
}

# one line, so bash has read all of it before the checkout can change the file under it
main "$@"; exit $?
